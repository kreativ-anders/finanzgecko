# Vorlage für packaging/macos/appstore.env — die echte Datei ist gitignored.
#
#   cp packaging/macos/appstore.env.example packaging/macos/appstore.env
#   # Werte eintragen, dann einfach:
#   ./packaging/macos/build_appstore.sh
#
# build_appstore.sh liest appstore.env automatisch ein, wenn sie existiert.
# Bereits gesetzte Umgebungsvariablen gewinnen — ein einmaliges
# `TEAM_ID=… ./packaging/macos/build_appstore.sh` überschreibt die Datei also.

# Die zehnstellige Apple-Team-ID (App Store Connect → Membership details).
export TEAM_ID=XXXXXXXXXX

# Das .provisionprofile vom Typ "Mac App Store" aus dem Developer-Portal.
# Bewusst AUSSERHALB des Repos: es enthält die Team-Identität.
export PROVISION_PROFILE="$HOME/Documents/Apple/FinanzGecko/FinanzGecko_Mac_App_Store.provisionprofile"

# Nur nötig, falls `codesign` den Namen als mehrdeutig ablehnt (mehrere
# Keychain-Einträge mit demselben Zertifikat). Dann die SHA-1 aus
# `security find-identity -v` eintragen.
# export APP_SIGN_IDENTITY=0000000000000000000000000000000000000000
# export PKG_SIGN_IDENTITY=0000000000000000000000000000000000000000
