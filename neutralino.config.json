{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "de.finanzgecko.app",
  "applicationName": "FinanzGecko",
  "version": "1.0.0",
  "author": "kreativanders",
  "description": "Nativer Vermögenstracker – lokal, ohne Cloud",
  "copyright": "Copyright © 2026 kreativanders",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "window.*",
    "events.*",
    "debug.log"
  ],
  "modes": {
    "window": {
      "title": "FinanzGecko",
      "width": 1280,
      "height": 860,
      "minWidth": 960,
      "minHeight": 640,
      "resizable": true,
      "maximize": true,
      "useSavedState": true,
      "icon": "/icons/icon-512.png",
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "finanzgecko",
    "resourcesPath": "/resources",
    "extensionsPath": "/extensions",
    "clientLibrary": "/resources/neutralino.js",
    "binaryVersion": "6.8.0",
    "clientVersion": "6.8.0"
  },
  "dataLocation": "system",
  "storageLocation": "system"
}
